# Kopieren nach deploy/compose/.env – enthält KEINE Geheimnisse.
# Geheimnisse liegen als Dateien in ${AKL_SECRETS_DIR} (Standard ./secrets),
# erzeugt mit:  scripts/init-secrets.sh

# Image (lokal gebaut: ai-keyless:dev; Releases später aus GHCR)
AKL_IMAGE=ai-keyless:dev
# Admin-UI nur lokal veröffentlichen; 0.0.0.0 nur bewusst und mit Firewall.
AKL_ADMIN_BIND=127.0.0.1
AKL_ADMIN_PORT=8090
AKL_SECRETS_DIR=./secrets
AKL_RUST_LOG=info
# Sitzungscookie nur über HTTPS senden (bei TLS-Reverse-Proxy auf true setzen)
AKL_COOKIE_SECURE=false
